{
  "name": "audit-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API аудиторской фирмы (Express + Prisma + PostgreSQL, TypeScript)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx prisma/ensure-db.ts && prisma generate && prisma migrate deploy && tsx prisma/seed-if-empty.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:gen-data": "tsx prisma/gen-seed.ts",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "prisma": "^7.10.1",
    "tsx": "^4.19.0"
  }
}

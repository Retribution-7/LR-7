{
  "name": "audit-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/server", "apps/client"],
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "cd apps/client && bun run dev",
    "dev:server": "cd apps/server && bun run dev",
    "db:setup": "cd apps/server && bun run db:setup",
    "db:seed": "cd apps/server && bun run db:seed",
    "db:gen-data": "cd apps/server && bun run db:gen-data",
    "typecheck": "cd apps/server && bun run typecheck && cd ../client && bun run typecheck"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.0"
  }
}
